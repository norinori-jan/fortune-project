  "taiyo_judgement": {
    "description": "体卦と用卦の五行関係から吉凶を判定するルール",
    "rules": [
      {
        "condition": "用が体を生ずる",
        "pattern": "youkua_element generates taikua_element",
        "judgement": "吉",
        "meaning": "事柄・相手が相談者を助ける。後押しあり。"
      },
      {
        "condition": "体が用を生ずる",
        "pattern": "taikua_element generates youkua_element",
        "judgement": "吝",
        "meaning": "相談者が与える側。消耗しやすい。頑張りすぎ注意。"
      },
      {
        "condition": "体用比和（同五行）",
        "pattern": "taikua_element === youkua_element",
        "judgement": "中平",
        "meaning": "力が拮抗している。均衡状態。どちらとも言えず。"
      },
      {
        "condition": "体が用を剋する",
        "pattern": "taikua_element controls youkua_element",
        "judgement": "吉",
        "meaning": "相談者が主導権を持つ。制御できる。"
      },
      {
        "condition": "用が体を剋する",
        "pattern": "youkua_element controls taikua_element",
        "judgement": "凶",
        "meaning": "事柄・相手が相談者を制圧する。厳しい状況。"
      }
    ]
  },

