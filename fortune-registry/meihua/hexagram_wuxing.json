  "ousei_rules": {
    "description": "月支による卦の旺衰判定ルール",
    "旺相": {
      "condition": "月支の五行が体卦を生ずる、または体卦と同五行",
      "effect": "体卦の力が増す。吉はより吉、凶は軽くなる。"
    },
    "休囚": {
      "condition": "体卦が月支の五行を生ずる（泄気）",
      "effect": "体卦の力が消耗する。長続きしない。"
    },
    "死": {
      "condition": "月支の五行が体卦を剋する",
      "effect": "体卦の力が制圧される。凶はより凶、吉も弱まる。"
    }
  }
