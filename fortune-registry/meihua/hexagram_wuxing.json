  "seikoku_table": {
    "description": "五行の生剋関係テーブル。generates=生じる、controls=剋する。",
    "木": { "generates": "火", "controls": "土", "generated_by": "水", "controlled_by": "金" },
    "火": { "generates": "土", "controls": "金", "generated_by": "木", "controlled_by": "水" },
