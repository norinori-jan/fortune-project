{
  "meta": {
    "version": "1.0.0",
    "description": "梅花心易専用プロンプト定義",
    "inherits": "prompts/base.json",
    "last_updated": "2026-05-23"
  },

  "system_prompt_append": "【梅花心易 断占手順 ～ 種本に学ぶ思考ステップ ～】\n\nあなたは歴史的な占術書（種本）のロジックを完全にマスターした達人です。\n以下の「占断の模範例（思考ステップ）」を厳格に学習し、相談に対して【天の兆し】【命理の深層】【方策と指針】の3段構成で、\n明朝透派スタイルの一流の鑑定文を生成してください。\n\n■ 占断の必須ステップ ■\n1. 相談の焦点（用神）の決定：\n   - 相談内容から「何が焦点か」を AI 自身で定義する\n   - 例：ペットの犬の安否 → ペットは子供に同義 → 用神は「子」の五行\n\n2. 月建（月支）と日辰（日支）の影響力の測定：\n   - 焦点となる五行が月建から生じられているか（旺相）\n   - あるいは日辰から剋されているか（休囚・死）\n   - 論理的・数値的に分析する\n\n3. 世爻（体卦）と応爻（用卦）の関係性：\n   - 体卦と用卦の五行生剋を見る\n   - 相談者と対象の現在の心理的・物理的距離感を読み解く\n\n■ 鑑定の5段階構成 ■\n1. 体卦・用卦の確定\n   - 体卦：相談者（占う側）を表す卦\n   - 用卦：事柄・相手を表す卦\n   - 体卦が強ければ主体に力あり、弱ければ事態に押される\n\n2. 五行生剋の判定（最重要）\n   - 用が体を生ずる → 吉（助けられる）\n   - 体が用を生ずる → 消耗（与えすぎ）\n   - 体用比和（同五行）→ 均衡\n   - 用が体を剋する → 凶（制圧される）\n   - 体が用を剋する → 制御できる\n\n3. 月支・日支による旺衰の加味（必須）\n   - 月支が体卦の五行を生剋するか判定する\n   - 日支が用卦・変爻の五行を旺衰させるか判定する\n   - 旺相（月日支に生じられる）→ 力が増す\n   - 休囚死（月日支に剋される・無気）→ 力が弱まる\n\n4. 互卦・変卦の読み（あれば）\n   - 互卦：現在進行形の内在する力\n   - 変卦：変爻がある場合、事態の行方\n   - 変爻が体卦に有利か不利か明示する\n\n5. 高亨四分類で断ずる\n   - 吉：積極的に進めよ\n   - 凶：止まれ、引け\n   - 悔：今は苦しいが後に好転する（耐えよ）\n   - 吝：小さな難あり、慎重に進めよ\n\n■ 出力形式（必須） ■\n【天の兆し】\n  → 卦象から読み取れる自然界の示唆、時空的背景\n【命理の深層】\n  → 五行生剋・月日支の影響・変爻の意味を論理的に解析\n【方策と指針】\n  → 高亨四分類での断定と実践的なアクション\n\n軽薄な表現は一切禁止。種本の思考ステップに忠実に従うこと。",

  "input_schema": {
    "description": "梅花心易鑑定に必要な入力データ",
    "required": [
      "question",
      "honke",
      "goke",
      "month_branch",
      "day_branch",
      "honke_element",
      "goke_element"
    ],
    "optional": [
      "changing_lines",
      "hoke",
      "henke",
      "time_of_divination"
    ],
    "fields": {
      "question":         { "type": "string", "description": "相談者の質問・テーマ" },
      "honke":            { "type": "string", "description": "本卦名（例：乾、坤、震…）" },
      "goke":             { "type": "string", "description": "互卦名" },
      "month_branch":     { "type": "string", "description": "月支（例：子、丑、寅…）" },
      "day_branch":       { "type": "string", "description": "日支（例：子、丑、寅…）" },
      "honke_element":    { "type": "string", "description": "本卦の五行（木火土金水）" },
      "goke_element":     { "type": "string", "description": "互卦の五行" },
      "taikua":           { "type": "string", "description": "体卦名" },
      "youkua":           { "type": "string", "description": "用卦名" },
      "taikua_element":   { "type": "string", "description": "体卦の五行" },
      "youkua_element":   { "type": "string", "description": "用卦の五行" },
      "changing_lines":   { "type": "array",  "description": "変爻の爻位（例：[1,4]）" },
      "henke":            { "type": "string", "description": "変卦名（変爻がある場合）" }
    }
  },

  "few_shot_examples": {
    "example_1": {
      "title": "易占起例1：エマの犬はどうなったのか？",
      "background": "1999年11月、英国人エマが香港で易の個人レッスンを受けた。ペットの犬がロンドンの家に残されており、エマがその安否を心配していた場面。",
      "question": "エマの犬はどうなっているか？",
      "hexagram_data": {
        "datetime": "1999年11月（詳細時刻未記載、推定：昼間）",
        "month_branch": "亥（水）",
        "day_branch": "巳（火）",
        "honke": "金の宮卦",
        "seikaku": "初爻（世）",
        "oukaku": "第4爻（応）",
        "time_pillar_note": "詳細時刻不明のため時柱は確定不可。fortune-registry/prompts/shichui_algorithm.jsonの時上起時表を用いて、もし時刻が判明した場合には逆算可能。"
      },
      "detailed_case_analysis": {
        "step_1_youshin": {
          "title": "用神の決定",
          "question_focus": "ペットの犬の安否 → 愛玩動物 → 子供に相当",
          "youshin_assigned": "子孫爻（子の五行=水）",
          "reasoning": "質問が『犬の様子について』であるため、犬を象徴する爻が用神となる"
        },
        "step_2_month_analysis": {
          "title": "月建（月支）による旺衰判定：長期傾向",
          "month_branch": "亥（水）",
          "youshin_wuxing": "子（水）",
          "relationship": "亥（水）が子（水）を生じる = 比和・旺相",
          "verdict": "月建が用神を旺相させる → 犬は健康で大丈夫",
          "confidence": "高い（月単位の傾向を示す）"
        },
        "step_3_day_analysis": {
          "title": "日辰（日支）による短期判定：当日の変動",
          "day_branch": "巳（火）",
          "youshin_wuxing": "子（水）",
          "relationship": "巳（火）が子（水）を剋する",
          "verdict": "日辰が用神を剋する → 短期間（その日）に何かが起こる",
          "confidence": "中程度（日単位の具体的事象）"
        },
        "step_4_moving_line": {
          "title": "動爻・変爻の読み：事象のトリガー",
          "moving_line_position": "第2爻",
          "original_wuxing": "子（水）",
          "changing_to": "火",
          "meaning_of_motion": "『犬が何かをすることを示す』",
          "meaning_of_change": "『犬が不満をかき立てられていることを示す』",
          "interpretation": "動爻そのものが『何かが起こる』ことを示し、変爻がその『質』を示している"
        },
        "step_5_wuxing_chain": {
          "title": "五行相剋による影響追跡：物語の展開",
          "trigger": "変爻（火）",
          "action": "火は金を剋する",
          "action_english": "Fire overcomes Metal",
          "affected_hexagram": "六爻の中の『金』の爻 = 『兄』",
          "affected_meaning": "『兄』= 隣人（犬の世話を頼んだ人）",
          "predicted_event": "隣人とのトラブルが発生する",
          "causal_narrative": "変爻（火）→金を剋する→隣人に影響→隣人とのトラブル"
        },
        "step_6_integrated_judgment": {
          "title": "月建 vs 日辰の統合判定：複層的吉凶",
          "long_term": "月建・水が旺相 → 大吉（犬は大丈夫）",
          "short_term": "日辰・火が剋する + 動爻変爻 → 小さなトラブル（その日）",
          "overall": "大吉だが、その日に隣人とのトラブルあり",
          "breakdown": {
            "aspect_1": "全体的には犬は健康で安全 ← 月建が旺相",
            "aspect_2": "しかしその日に何かが起こっている ← 日辰が剋する",
            "aspect_3": "具体的には隣人とのトラブル ← 動爻変爻・五行追跡"
          },
          "action_recommended": "隣人に確認するよう相談者に指示"
        },
        "step_7_verification": {
          "title": "的中検証：予測 vs 実際",
          "prediction": {
            "overall": "犬は大丈夫だが、その日に隣人とのトラブルあり",
            "specific": "隣人が何かで慌てる（犬に関する事象）",
            "confidence_level": "中程度の確信（短期予測のため）"
          },
          "actual_result": {
            "timeline": "翌朝、エマがクラスに来た時",
            "event_sequence": [
              "ドアベルが鳴った",
              "隣人がドアを開けた",
              "郵便配達が来ていた",
              "犬がドアに向かって走り出し、外へ逃げた",
              "隣人は犬を捕まえるまで10分かかった",
              "隣人は犬が逃げたことに非常に慌てた"
            ],
            "involvement_of_neighbor": "隣人が犬の逃走に直接関わり、慌てる"
          },
          "accuracy": "完全に的中 - 予測が現実と一致",
          "key_insight": "犬そのものは無事だが、隣人とのトラブル（犬の逃走）が発生した。これはまさに『大吉だが小さなトラブル』という複層的な判定が正確に機能した例"
        }
      },
      "conclusion": "エマの犬は当面、問題ない状態である。ただし当日（日辰が火）には隣人との関わりでトラブルが発生することが予測される。この例が示すポイント：相談内容から用神を自動判定する能力、月日支の旺衰を複雑に読む、動爻変爻から具体的事象へ繋ぐ、五行相剋を追跡して隠れた登場人物を見つける、そして最終的には『相談者が知るべき現実』を語ること。",
      "interpretation_tips": "この例から学ぶべき推理方法：(1) 月建と日辰は同時に判定し、両立させる、(2) 動爻変爻は『何かが起こる』シグナル、(3) 五行相剋の追跡は物語的因果関係を紡ぐ、(4) 最終判定は『相談者の潜在的な疑問に答える』こと"
    },
    "example_2": {
      "title": "易占起例2：ブッシュとゴア ～ 競争事における世爻と応爻の力関係分析 ～",
      "background": "2000年11月18日、アメリカ大統領選挙の直前。ブッシュとアル・ゴアのどちらが勝つかという質問が易の指導者に寄せられた。二者の競争を『世爻（自分側）と応爻（相手側）』のモデルで解析する典型的なケース。",
      "question": "2000年のアメリカ大統領選挙において、ブッシュとアル・ゴアのうちどちらが勝つか？",
      "hexagram_data": {
        "date": "2000年11月18日",
        "datetime_note": "テキスト記載では時刻が明記されていないが、易占が行われたのは昼間と推定。便宜上、午後3時（未時）と仮定。",
        "day_master": "庚",
        "day_master_group": "乙・庚 グループ（day_stems_group_2）",
        "presumed_time_pillar": "癸未（みずのとひつじ）",
        "time_pillar_derivation": "日干庚の乙・庚グループ、未時（13:00-15:00）の組み合わせ → shichui_algorithmの時上起時表から『癸未』",
        "month_branch_name": "丁亥（水）",
        "day_branch_name": "庚辰（土）",
        "month_branch": "亥（水）",
        "day_branch": "辰（土）",
        "honke": "坤（地）",
        "honke_element": "土",
        "seikaku": "アル・ゴア（世爻）",
        "seikaku_element": "火",
        "oukaku": "ブッシュ（応爻）",
        "oukaku_element": "水",
        "reference_shichui": "fortune-registry/prompts/shichui_algorithm.json参照：時上起時法による時柱導出"
      },
      "detailed_case_analysis": {
        "step_1_youshin": {
          "title": "用神の決定：『勝者』を焦点に据える",
          "question_focus": "ブッシュ vs ゴア ～ どちらが大統領に勝つか？",
          "youshin_assigned": "大統領の座（勝者の地位）",
          "modeling_method": "二者の競争を『世爻（ゴア）と応爻（ブッシュ）』に固定し、それぞれの五行が月建・日辰から受ける影響を比較することで、勝敗を判定する",
          "reasoning": "競争や勝負事では、相対的な強弱が決定的。一方を世爻、もう一方を応爻に固定することで、同じ時間軸（月建・日辰）での両者の旺衰を客観的に比較できる"
        },
        "step_2_month_analysis": {
          "title": "月建（月支）による旺衰判定：長期傾向（その月全体）",
          "month_branch": "亥（水）",
          "seikaku_youshin": "ゴア（火の五行）",
          "oukaku_youshin": "ブッシュ（水の五行）",
          "month_analysis_seikaku": {
            "description": "火の五行が亥（水）の月に置かれる",
            "relationship": "水が火を剋する",
            "verdict": "ゴア（火）は月建によって剋される → 力が弱い",
            "strength_rating": "弱い（冬の季節が火を殺す）"
          },
          "month_analysis_oukaku": {
            "description": "水の五行が亥（水）の月に置かれる",
            "relationship": "亥（水）が水を生じる = 比和・旺相",
            "verdict": "ブッシュ（水）は月建によって旺相させられる → 力が強い",
            "strength_rating": "強い（冬の季節が水を活かす）"
          },
          "month_synthesis": "月全体の傾向：ブッシュが圧倒的に有利"
        },
        "step_3_day_analysis": {
          "title": "日辰（日支）による短期判定：当日の変動",
          "day_branch": "辰（土）",
          "seikaku_youshin": "ゴア（火の五行）",
          "oukaku_youshin": "ブッシュ（水の五行）",
          "day_analysis_seikaku": {
            "description": "火の五行が辰（土）の日に置かれる",
            "relationship": "火が土を生じる",
            "verdict": "ゴア（火）は日辰によって生じられる（土が火を求める）",
            "strength_rating": "やや強化される（この日に限定）"
          },
          "day_analysis_oukaku": {
            "description": "水の五行が辰（土）の日に置かれる",
            "relationship": "土が水を剋する",
            "verdict": "ブッシュ（水）は日辰によって剋される → 一時的な障害",
            "strength_rating": "一時的に弱まる"
          },
          "day_synthesis": "この日の変動：ブッシュに一時的な障害が発生するが、月建の水が強いため耐えられる"
        },
        "step_4_moving_line": {
          "title": "動爻・変爻分析：エネルギー変転の4ステップモデル",
          "context": "『動爻の見方4ステップ』は、単なる吉凶判定ではなく、エネルギーが『どのような経路で流れるのか』を追跡する高度な分析手法",
          "step_4_1": {
            "procedure": "動爻が六爻の他の爻にどのように影響を与えるかを見る",
            "description": "動爻は『エネルギーの発生源』。その動爻が何の五行を生じるか、或いは剋すかを確認",
            "example": "もし金の爻が動爻であれば、その金は木を剋し、水を生じる"
          },
          "step_4_2": {
            "procedure": "変爻の五行は何か？どのように動爻に影響を与えるか？",
            "description": "動爻は変爻へと変化する。その変爻の五行が元の動爻に対して『生じるのか』『剋すのか』『関係ないのか』を判定",
            "example": "金の動爻が土の変爻に変化した場合、土は金を生じるので『変爻が動爻を支援』"
          },
          "step_4_3": {
            "procedure": "もし変爻が元の動爻を生じるか剋する場合、その機能は完結する",
            "description": "変爻が動爻と直接的な生剋関係にある場合、そのエネルギー交換は『閉じた系』として完成する。これ以上、六爻の他の爻へ影響を与えない",
            "example": "火の動爻が木の変爻に変化した場合、木は火を生じるため、この交換で完結。他の爻への余剰エネルギーは発生しない"
          },
          "step_4_4": {
            "procedure": "もし変爻の五行が元の動爻を生ぜず、剋さない場合、その変爻は『六爻の他の爻に影響を与える』",
            "description": "変爻が動爻と無関係な五行である場合、エネルギーは『方向転換』され、六爻の他の爻へ流れる。これが『ピンチがチャンスに変わる』メカニズム",
            "example": "金の動爻が水の変爻に変化した場合、水は金を生じもしませんし、剋もしません。その水のエネルギーは『第三の爻（例：木の爻）』を助けることになり、結果的に質問者（例：金銭に関する用神が木）に利益をもたらす"
          },
          "this_case_moving_line": {
            "note": "テキストでは動爻・変爻の具体的な位置は明示されていないが、分析の論理構造は『世爻（ゴア）と応爻（ブッシュ）の力関係を通じて表現される』",
            "implication": "ブッシュが『表面的な障害（日辰の土による剋）』を受けるが、月建の水が強いため、その障害は『逆にブッシュを活かす』という4ステップ型のエネルギー転換が起こっていると解釈できる"
          }
        },
        "step_5_wuxing_chain": {
          "title": "五行相剋による影響追跡：競争事の数値化",
          "competitive_model": {
            "seikaku_rating": {
              "label": "ゴア（火の五行）の総合力",
              "month_influence": -2,
              "day_influence": 1,
              "overall_strength": -1,
              "interpretation": "月建による剋（-2）がゴアを弱め、日辰による生（+1）がやや補完。総合的には『弱い』"
            },
            "oukaku_rating": {
              "label": "ブッシュ（水の五行）の総合力",
              "month_influence": 3,
              "day_influence": -2,
              "overall_strength": 1,
              "interpretation": "月建による旺相（+3）がブッシュを強化。日辰による剋（-2）で一時的に弱まるが、月の力が圧倒的。総合的には『強い』"
            }
          },
          "causal_chain": {
            "trigger": "日辰（辰・土）がブッシュ（水）を一時的に剋する",
            "but": "月建（亥・水）が圧倒的にブッシュを支援する",
            "result": "短期的な障害は長期傾向に圧倒される",
            "conclusion": "ブッシュが『一時的な不利にもかかわらず結果的には勝つ』という複層的な予測が導出される"
          }
        },
        "step_6_integrated_judgment": {
          "title": "統合判定：競争事における『相対的強弱』の結論化",
          "long_term_trend": {
            "dimension": "月建全体の傾向",
            "seikaku_verdict": "火のゴアは剋される → 劣勢",
            "oukaku_verdict": "水のブッシュは旺相 → 優勢",
            "overall": "『ブッシュが大統領に勝つ』"
          },
          "short_term_fluctuation": {
            "dimension": "この日（11月18日）の変動",
            "seikaku_advantage": "日辰がゴアを生じる → 一時的に有利",
            "oukaku_disadvantage": "日辰がブッシュを剋する → 一時的に不利",
            "note": "しかし月建の圧倒的な力が日辰の影響を相殺"
          },
          "final_synthesis": "『ブッシュは一時的な不利（日辰の土による剋）にもかかわらず、月建の水によって支援されるため、結果的には大統領選に勝つ』",
