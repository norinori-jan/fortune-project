            "example": "金の動爻が水の変爻に変化した場合、水は金を生じもしませんし、剋もしません。その水のエネルギーは『第三の爻（例：木の爻）』を助けることになり、結果的に質問者（例：金銭に関する用神が木）に利益をもたらす"
          },
          "this_case_moving_line": {
            "note": "テキストでは動爻・変爻の具体的な位置は明示されていないが、分析の論理構造は『世爻（ゴア）と応爻（ブッシュ）の力関係を通じて表現される』",
            "implication": "ブッシュが『表面的な障害（日辰の土による剋）』を受けるが、月建の水が強いため、その障害は『逆にブッシュを活かす』という4ステップ型のエネルギー転換が起こっていると解釈できる"
          }
        },
        "step_5_wuxing_chain": {
          "title": "五行相剋による影響追跡：競争事の数値化",
          "competitive_model": {
            "seikaku_rating": {
              "label": "ゴア（火の五行）の総合力",
              "month_influence": -2,
              "day_influence": 1,
              "overall_strength": -1,
              "interpretation": "月建による剋（-2）がゴアを弱め、日辰による生（+1）がやや補完。総合的には『弱い』"
            },
            "oukaku_rating": {
              "label": "ブッシュ（水の五行）の総合力",
              "month_influence": 3,
              "day_influence": -2,
              "overall_strength": 1,
              "interpretation": "月建による旺相（+3）がブッシュを強化。日辰による剋（-2）で一時的に弱まるが、月の力が圧倒的。総合的には『強い』"
            }
          },
          "causal_chain": {
            "trigger": "日辰（辰・土）がブッシュ（水）を一時的に剋する",
            "but": "月建（亥・水）が圧倒的にブッシュを支援する",
            "result": "短期的な障害は長期傾向に圧倒される",
            "conclusion": "ブッシュが『一時的な不利にもかかわらず結果的には勝つ』という複層的な予測が導出される"
          }
        },
        "step_6_integrated_judgment": {
          "title": "統合判定：競争事における『相対的強弱』の結論化",
          "long_term_trend": {
            "dimension": "月建全体の傾向",
            "seikaku_verdict": "火のゴアは剋される → 劣勢",
            "oukaku_verdict": "水のブッシュは旺相 → 優勢",
            "overall": "『ブッシュが大統領に勝つ』"
          },
          "short_term_fluctuation": {
            "dimension": "この日（11月18日）の変動",
            "seikaku_advantage": "日辰がゴアを生じる → 一時的に有利",
            "oukaku_disadvantage": "日辰がブッシュを剋する → 一時的に不利",
            "note": "しかし月建の圧倒的な力が日辰の影響を相殺"
          },
          "final_synthesis": "『ブッシュは一時的な不利（日辰の土による剋）にもかかわらず、月建の水によって支援されるため、結果的には大統領選に勝つ』",
          "confidence_level": "高い（月建と日辰の両者から一貫した答え）",
          "decision_authority": "世爻（ゴア・火）と応爻（ブッシュ・水）の力関係は、競争事における客観的な強弱判定の最善の方法である"
        },
        "step_7_verification": {
          "title": "的中検証：歴史的事実との照合",
          "prediction_summary": {
            "predicted_outcome": "ブッシュが大統領選に勝つ",
            "predicted_mechanism": "ブッシュ（水）は月建（亥・水）に強く支援される。日辰（辰・土）の障害はあるが、月の力が優位",
            "predicted_timing": "短期的には変動があるが、最終的にはブッシュが勝つ"
          },
          "historical_verification": {
