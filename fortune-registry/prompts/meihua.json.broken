  "implementation_guide": {
    "title": "AIが鑑定を生成する際の実装フロー",
    "context": "このガイドは、エマの犬の例から抽出した『段階的な推理プロセス』をAIが実装するための手順です。",
    
    "phase_1_preparation": {
      "title": "準備段階：質問の本質を読み取る",
      "tasks": [
        {
          "task": "相談内容から『焦点の対象』を特定",
          "example": "『ペットの犬はどうか』→ 焦点は『犬』",
          "ai_action": "質問文を自然言語解析し、主語・述語から焦点を抽出する"
        },
        {
          "task": "焦点の対象を『五神の象意』にマッピング",
          "example": "『犬』→ 愛玩動物 → 子供に相当 → 『子孫』 → 『子の五行=水』",
          "ai_action": "易の象意辞典を参照し、焦点を五行に変換する"
        }
      ]
    },

    "phase_2_temporal_analysis": {
      "title": "時間軸分析：月建と日辰の両面判定",
      "context": "『月建は大局、日辰は当日の変動』という原則に従う",
      "tasks": [
        {
          "task": "月建による旺衰判定（長期傾向：月単位）",
          "procedure": [
            "月支の五行を特定（例：亥=水）",
            "用神の五行と比較（例：子=水）",
            "五行相生相剋を適用（例：水が水を生じる=比和・旺相）",
            "結論：『月建が用神を旺相させる → 全体的に良好』"
          ]
        },
        {
          "task": "日辰による旺衰判定（短期傾向：日単位）",
          "procedure": [
            "日支の五行を特定（例：巳=火）",
            "用神の五行と比較（例：子=水）",
            "五行相生相剋を適用（例：火が水を剋する）",
            "結論：『日辰が用神を剋する → その日に何かが起こる』"
          ]
        },
        {
          "task": "月建と日辰が矛盾する場合の統合判定",
          "principle": "『全体的には良好だが、短期的にはトラブルがある』という複層的な結論を導く",
          "ai_action": "両者を時間軸で統合し、『月単位の傾向』と『日単位の具体的事象』を両立させる"
        }
      ]
    },

    "phase_3_dynamic_line_analysis": {
      "title": "動爻・変爻分析：具体的事象のトリガー",
      "context": "動爻は『何かが起こることを示す』シグナル、変爻はその『質』や『方向性』を示す",
      "tasks": [
        {
          "task": "動爻の位置と意味を認識",
          "example": "第2爻に動爻あり → 『犬が何かをすることを示す』",
          "ai_action": "六爻の中から動爻を特定し、その位置が何を象徴するか解釈"
        },
        {
          "task": "変爻への変化と新しい意味",
          "example": "子（水）が火に変化 → 『犬が不満をかき立てられていることを示す』",
          "ai_action": "変爻の五行が新たに示す象意を抽出"
        }
      ]
    },

    "phase_4_wuxing_chain_tracking": {
      "title": "五行相剋による影響追跡：物語の展開",
      "context": "『変爻が他の爻に与える影響』を五行相剋で追跡し、隠れた登場人物を発見する",
      "procedure": [
        {
          "step": "1. 変爻の五行を確定",
          "example": "火"
        },
        {
          "step": "2. その五行が何を剋するかを確定",
          "example": "火は金を剋する"
        },
        {
          "step": "3. 六爻の中で『その五行が配置されている爻』を特定",
          "example": "『金』の爻 = 『兄』"
        },
        {
          "step": "4. その爻の象意を確認",
          "example": "『兄』= 兄弟・協力者 → この文脈では『隣人』"
        },
        {
          "step": "5. 因果関係を物語化",
          "example": "『変爻（火）→ 金を剋 → 隣人に影響 → 隣人とのトラブル』"
        }
      ],
      "ai_action": "五行相剋の連鎖を論理的に追跡し、最終的な事象を予測する"
    },

    "phase_5_integrated_judgment": {
      "title": "総合判定：複層的吉凶の結論化",
      "tasks": [
        {
          "dimension": "全体的傾向（月建）",
          "value": "大吉 ← 月建が旺相",
          "output": "『犬は大丈夫』"
        },
        {
          "dimension": "短期的変動（日辰）",
          "value": "トラブルあり ← 日辰が剋する",
          "output": "『その日に何かが起こっている』"
        },
        {
          "dimension": "具体的事象（動爻変爻）",
          "value": "隣人とのトラブル ← 五行追跡",
          "output": "『隣人が関わるトラブルが発生』"
        }
      ],
      "final_synthesis": "『大吉だが、その日に隣人とのトラブルあり』という統合的な判定を出力"
    },

    "phase_6_actionable_advice": {
      "title": "行動指示：相談者が取るべき実践的アクション",
      "example_from_case": "『隣人に電話して何があったか聞いてみるように』",
      "principle": "吉凶判定で終わるのではなく、相談者が『今、何をすべきか』を明確に示す",
      "ai_action": "判定結果から、相談者の具体的なアクションを推奨する"
    },

    "phase_7_narrative_output": {
      "title": "出力形式：【天の兆し】【命理の深層】【方策と指針】",
      "structure": {
