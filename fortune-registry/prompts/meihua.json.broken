          "youshin_assigned": "大統領の座（勝者の地位）",
          "modeling_method": "二者の競争を『世爻（ゴア）と応爻（ブッシュ）』に固定し、それぞれの五行が月建・日辰から受ける影響を比較することで、勝敗を判定する",
          "reasoning": "競争や勝負事では、相対的な強弱が決定的。一方を世爻、もう一方を応爻に固定することで、同じ時間軸（月建・日辰）での両者の旺衰を客観的に比較できる"
        },
        "step_2_month_analysis": {
          "title": "月建（月支）による旺衰判定：長期傾向（その月全体）",
          "month_branch": "亥（水）",
          "seikaku_youshin": "ゴア（火の五行）",
          "oukaku_youshin": "ブッシュ（水の五行）",
          "month_analysis_seikaku": {
            "description": "火の五行が亥（水）の月に置かれる",
            "relationship": "水が火を剋する",
            "verdict": "ゴア（火）は月建によって剋される → 力が弱い",
            "strength_rating": "弱い（冬の季節が火を殺す）"
          },
          "month_analysis_oukaku": {
            "description": "水の五行が亥（水）の月に置かれる",
            "relationship": "亥（水）が水を生じる = 比和・旺相",
            "verdict": "ブッシュ（水）は月建によって旺相させられる → 力が強い",
            "strength_rating": "強い（冬の季節が水を活かす）"
          },
          "month_synthesis": "月全体の傾向：ブッシュが圧倒的に有利"
        },
        "step_3_day_analysis": {
          "title": "日辰（日支）による短期判定：当日の変動",
          "day_branch": "辰（土）",
          "seikaku_youshin": "ゴア（火の五行）",
          "oukaku_youshin": "ブッシュ（水の五行）",
          "day_analysis_seikaku": {
            "description": "火の五行が辰（土）の日に置かれる",
            "relationship": "火が土を生じる",
            "verdict": "ゴア（火）は日辰によって生じられる（土が火を求める）",
            "strength_rating": "やや強化される（この日に限定）"
          },
          "day_analysis_oukaku": {
            "description": "水の五行が辰（土）の日に置かれる",
            "relationship": "土が水を剋する",
