  "prompt_template": "【梅花心易 鑑定依頼 ～ 三段構成で断ずる ～】\n\n相談テーマ：{{question}}\n本卦：{{honke}}（{{honke_element}}）\n互卦：{{goke}}（{{goke_element}}）\n体卦：{{taikua}}（{{taikua_element}}）\n用卦：{{youkua}}（{{youkua_element}}）\n月建：{{month_branch}}\n日辰：{{day_branch}}\n変爻：{{changing_lines_text}}\n変卦：{{henke}}\n\n■ 鑑定フロー ■\n1. 用神（焦点）を相談内容から AI 自身で定義する\n2. 月建・日辰がその用神にいかなる生剋を与えるかを分析\n3. 世爻（体卦）と応爻（用卦）の力関係を判断\n4. 【天の兆し】【命理の深層】【方策と指針】の3段構成で出力\n\n■ 最終判定 ■\n上記のデータをもとに、明朝透派の断占スタイルで鑑定してください。\n五行生剋・月日支旺衰・変爻の読みを必ず含め、高亨四分類（吉・凶・悔・吝）で結論を出してください。\n軽薄な表現は一切禁止。論理的かつ権威的に断定すること。",

  "breakdown_labels": {
    "taikua_strength": "体卦の強さ",
    "youkua_strength": "用卦の強さ",
    "seikoku":         "生剋関係",
    "month_influence": "月支の影響",
    "day_influence":   "日支の影響",
    "henke_direction": "変化の方向"
  },

  "reasoning_methodology": {
    "title": "種本に基づく推理方法論",
    "methods": {
      "goshin_identification": {
        "name": "用神（焦点）の判定",
        "description": "相談内容から『何が問題の中心か』を自動判定する。例：子供の成績 → 子孫（木）の五行 / 仕事の契約 → 官鬼（火）の五行 / 金銭 → 財爻（土）の五行",
        "examples": [
          "ペットの安否 → 子孫卦（木の五行）",
          "配偶者の心情 → 妻財卦（土の五行）",
          "仕事の展開 → 官鬼卦（火の五行）",
          "敵対者の動き → 兄弟卦（金の五行）"
        ]
      },
      "month_day_analysis": {
        "name": "月建・日辰の旺衰判定",
        "description": "用神の五行が月支・日支からいかなる生剋を受けるか論理的に分析",
        "wuxing_cycle": {
          "seiikoku": "木→火→土→金→水→木（相生）",
          "sakukoku": "木→土→水→火→金→木（相剋）"
        },
        "evaluations": {
          "ousou": "月日支が用神を生じる → 旺相（力が増す）",
          "kyushu": "月日支が用神と比和（同じ五行）→ 休囚（やや減衰）",
          "shikyu": "月日支が用神を剋する → 死・休囚（力が弱い）"
        }
      },
      "taikua_youkua_relationship": {
        "name": "世爻と応爻の関係性",
        "description": "体卦（相談者）と用卦（対象）の五行生剋を見て、心理的・物理的距離を読み解く",
        "interpretation": {
          "taikua_generates_youkua": "体卦が用卦を生じる → 相談者が優位（積極的影響）",
          "youkua_generates_taikua": "用卦が体卦を生じる → 対象が有利（受動的支援）",
          "mutual_harmony": "比和 → 均衡状態（協調的）",
          "taikua_suppresses_youkua": "体卦が用卦を剋する → 相談者が制御可能",
          "youkua_suppresses_taikua": "用卦が体卦を剋する → 相談者が圧迫される（困難）"
        }
      },
      "henke_reading": {
        "name": "変卦の読み（変爻がある場合）",
        "description": "変爻を通じて事態の今後の展開を見る。変爻が体卦に有利か不利かを明示することが重要",
        "points": [
          "変爻の五行が月日支からいかなる影響を受けるか",
          "変爻が世爻（体卦）に有利か、応爻（用卦）に有利か",
          "変卦の象意が全体の結論をどう支持するか"
        ]
      }
    }
  },

