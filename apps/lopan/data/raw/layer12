# Validation
# ==========================================================

def validate_layer12(data):
"""
Layer12の基本構造を検証する。
"""

errors = []

if len(data) != ITEM_COUNT:
errors.append(
f"区分数が {ITEM_COUNT} ではありません: {len(data)}"
)

if data and data[0]["degree_start"] != DEGREE_START:
errors.append(
f"開始角度が {DEGREE_START}° ではありません"
)

for item in data:
start = item["degree_start"]
end = item["degree_end"]

if not (0 <= start < 360):
errors.append(
f"id={item['id']} start角度異常: {start}"
)

if not (0 <= end < 360):
errors.append(
f"id={item['id']} end角度異常: {end}"
)

if not isinstance(item["raw_number"], int):
errors.append(
f"id={item['id']} raw_numberが整数ではありません"
)

if not item["raw_text"]:
errors.append(
f"id={item['id']} raw_textが空です"
)

if not item["raw_element"]:
errors.append(
f"id={item['id']} raw_elementが空です"
)

for previous, current in zip(data, data[1:]):
if previous["degree_end"] != current["degree_start"]:
errors.append(
f"id={previous['id']} → "
f"id={current['id']} 角度が連続していません"
)

# 最後の330°への復帰を確認
if data and data[-1]["degree_end"] != DEGREE_START:
errors.append(
"最終区分が330°へ戻っていません"
)

return errors


