def validate_layer11(data):

    """
    Layer11の基本構造を検証する。
    """

errors = []

if len(data) != ITEM_COUNT:
    errors.append(
    f"区分数が {ITEM_COUNT} ではありません: {len(data)}"
)

for item in data:
    if item["degree_start"] < 0 or item["degree_start"] >= 360:
        errors.append(f"id={item['id']} start角度異常")

if item["degree_end"] < 0 or item["degree_end"] >= 360:
    errors.append(f"id={item['id']} end角度異常")

for previous, current in zip(data, data[1:]):
    if previous["degree_end"] != current["degree_start"]:
        errors.append(
f"id={previous['id']} → id={current['id']} "
"角度が連続していません"
)

return errors


