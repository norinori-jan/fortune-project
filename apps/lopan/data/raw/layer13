"direction": "右回り",
}


# ==========================================================
# Validation
# ==========================================================

def validate_layer13(data):
"""
Layer13の基本構造を検証する。
"""

errors = []

if len(data) != ITEM_COUNT:
errors.append(
f"区分数が {ITEM_COUNT} ではありません: {len(data)}"
)

for item in data:

start = item["degree_start"]
end = item["degree_end"]

if not (0 <= start < 360):
errors.append(
f"id={item['id']} start角度異常: {start}"
)

if not (0 <= end < 360):
errors.append(
f"id={item['id']} end角度異常: {end}"
)

if item["raw_text"] == "":
errors.append(
f"id={item['id']} raw_textが空です"
)

# 全体の3°連続性
for previous, current in zip(data, data[1:]):

if previous["degree_end"] != current["degree_start"]:
errors.append(
f"id={previous['id']} → "
f"id={current['id']} "
"角度が連続していません"
)

# 330°へ戻る
if data and data[-1]["degree_end"] != 330.0:
errors.append(
"最終区分が330°へ戻っていません"
)

# 各Layer12区分が5分割されているか
for parent_id in range(1, 25):

children = [
item
for item in data
if item["parent_layer12_id"] == parent_id
]

if len(children) != 5:
errors.append(
f"Layer12 id={parent_id} の"
f"子区分数が5ではありません: {len(children)}"
)

return errors


