# ==========================================================

def validate_layer10(data):
"""
Layer10 の基本構造を検証する。
"""

errors = []

if len(data) != ITEM_COUNT:
errors.append(
f"区分数が {ITEM_COUNT} ではありません: {len(data)}"
)

if data:
if data[0]["degree_start"] != DEGREE_START:
errors.append(
f"開始角度が {DEGREE_START}° ではありません"
)

for item in data:
start = item["degree_start"]
end = item["degree_end"]

if start < 0 or start >= 360:
errors.append(f"id={item['id']} start角度異常")

if end < 0 or end >= 360:
errors.append(f"id={item['id']} end角度異常")

for previous, current in zip(data, data[1:]):
if previous["degree_end"] != current["degree_start"]:
errors.append(
f"id={previous['id']} → id={current['id']} "
"角度が連続していません"
)

return errors


