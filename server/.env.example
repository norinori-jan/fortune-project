# 🔮 Tarot Fortune Server Configuration
# =======================================
# SECURITY: Copy this file to .env and fill in your actual API keys
# ⚠️  IMPORTANT: 
#     1. .env is listed in .gitignore - NEVER commit API keys
#     2. Keep .env file private and backed up safely
#     3. Rotate API keys regularly
#     4. Use separate API keys for development and production

# ═══════════════════════════════════════════
# AI API Keys (Required for tarot interpretation)
# ═══════════════════════════════════════════

# Gemini API (Google - Required)
# Get from: https://console.cloud.google.com/apis/credentials
# Generate a new API key, then paste here:
GEMINI_API_KEY=

# OpenAI API (Required)
# Get from: https://platform.openai.com/api-keys
# Generate a new Secret Key, then paste here:
OPENAI_API_KEY=

# Claude API (Optional - not yet integrated)
# Get from: https://console.anthropic.com/
# Generate a new API key, then paste here:
# CLAUDE_API_KEY=

# ═══════════════════════════════════════════
# Flask Server Configuration (Optional)
# ═══════════════════════════════════════════

FLASK_ENV=development
FLASK_DEBUG=True
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
